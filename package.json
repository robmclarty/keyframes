{
  "name": "@robmclarty/keyframes",
  "version": "0.1.1",
  "description": "One markdown file where people write a project's intent, for other people to build on and agents to be guided by, checked the same way every time.",
  "license": "Apache-2.0",
  "author": "Rob McLarty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmclarty/keyframes.git"
  },
  "homepage": "https://github.com/robmclarty/keyframes#readme",
  "bugs": "https://github.com/robmclarty/keyframes/issues",
  "type": "module",
  "bin": {
    "keyframes": "bin/keyframes.js"
  },
  "files": [
    "bin/",
    "dist/",
    "schema/",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "check": "checkride",
    "check:all": "checkride --all",
    "check:json": "checkride --json",
    "check:bail": "checkride --bail",
    "check:changed": "checkride --changed",
    "check:fix": "checkride fix",
    "doctor": "checkride doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build",
    "types": "tsc --build",
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --build --force"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "checkride": "0.13.0",
    "cspell": "10.2.0",
    "fallow": "3.22.0",
    "markdownlint-cli2": "0.23.2",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
