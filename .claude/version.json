{
  "targets": [
    {
      "type": "json",
      "path": "package.json",
      "key": "version"
    }
  ],
  "marker": {
    "commit": "v{version}",
    "tag": true,
    "tagAuthoritative": false,
    "legacy": []
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "style": "sections",
    "linkRef": null
  },
  "verify": null,
  "publish": {
    "pushTag": true,
    "pushBranch": false,
    "confirm": true
  }
}
