{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR:-.}/.check\" && touch \"${CLAUDE_PROJECT_DIR:-.}/.check/.dirty\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(**/checkride.baseline.json)",
      "Edit(**/.check/**)"
    ]
  }
}
